# =============================================================================
# PyGuardian AI - Git Ignore Rules
# =============================================================================

# ─── Environment Variables & Secrets (CRITICAL) ──────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production
.env.*
backend/.env
backend/.env.local
backend/.env.development
backend/.env.test
backend/.env.production
backend/.env.*

# Explicitly track safe example template files
!.env.example
!backend/.env.example

# Secret keys, credentials, and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
client_secret*.json
passwords.txt
secrets/

# ─── Python Virtual Environments ─────────────────────────────────────────────
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
env.bak/
venv.bak/

# ─── Python Bytecode & Cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.pytype/
.ruff_cache/

# ─── Node & Frontend Dependencies & Build Outputs ─────────────────────────────
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Local Database Files ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Packaging & Distribution ─────────────────────────────────────────────────
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── IDE & Editor Configurations ──────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ─── Operating System Files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Temporary Files ──────────────────────────────────────────────────────────
*.tmp
*.temp
~*
backend/temp.py
