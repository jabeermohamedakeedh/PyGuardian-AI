# =============================================================================
# PyGuardian AI - Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials.
# NEVER commit the real .env file with actual credentials to version control.
# =============================================================================

# Database Configuration (PostgreSQL / Supabase Direct Connection)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP Email Configuration (Used for password reset emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# JWT Authentication Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
